<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: data aplikasi tidak ikut cadangan cloud maupun transfer perangkat (selaras dengan allowBackup=false).
     Pencadangan dilakukan lewat fitur Cadangan lokal di dalam aplikasi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
